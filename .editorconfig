root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_properties = false:warning
csharp_style_expression_bodied_accessors = false:warning
csharp_style_expression_bodied_local_functions = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
# ReSharper / Rider settings
resharper_csharp_brace_style = next_line
resharper_csharp_empty_block_style = multiline
resharper_csharp_keep_existing_embedded_block_arrangement = false
resharper_csharp_keep_existing_declaration_block_arrangement = false
resharper_csharp_keep_existing_statement_arrangement = false
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_blank_lines_before_control_transfer_statements = 1
resharper_csharp_blank_lines_around_invocable = 1
resharper_csharp_blank_lines_around_field = 0
resharper_csharp_blank_lines_around_property = 1
resharper_csharp_use_indent_from_vs = false
resharper_csharp_use_heuristics_for_body_style = false
resharper_csharp_method_body = block_body
resharper_csharp_property_body = accessors_with_block_body
resharper_csharp_accessor_body = block_body
resharper_csharp_for_built_in_types = use_var
resharper_csharp_for_simple_types = use_var
resharper_csharp_for_other_types = use_var
resharper_csharp_braces_for_ifelse = required
resharper_csharp_braces_for_for = required
resharper_csharp_braces_for_foreach = required
resharper_csharp_braces_for_while = required
resharper_csharp_braces_for_dowhile = required
resharper_csharp_braces_for_using = required
resharper_csharp_braces_for_lock = required
resharper_arrange_redundant_parentheses_highlighting = suggestion

# Explicit diagnostic severities (also evaluated during dotnet build).
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0008.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0025.severity = error
dotnet_diagnostic.IDE0027.severity = error
dotnet_diagnostic.IDE0061.severity = error
dotnet_diagnostic.IDE0161.severity = error
resharper_csharp_place_simple_embedded_statement_on_same_line = false
resharper_csharp_blank_lines_around_multiline_case_section = 1
