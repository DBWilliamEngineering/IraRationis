<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Blake3" Version="3.0.2" />
        <PackageVersion Include="Tomlyn" Version="2.10.1" />
        <!-- Direct3D 12 and DXGI interop types. -->
        <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <!-- Managed Opus codec; no Concentus.Native package. -->
        <PackageVersion Include="Concentus" Version="2.2.2" />
    </ItemGroup>
</Project>
